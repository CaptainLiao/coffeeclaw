{
  "name": "mock-plan",
  "version": "1.0.0",
  "description": "Mock planning tool used by demo agent.",
  "input_schema": {
    "type": "object",
    "properties": {
      "question": {
        "type": "string",
        "description": "The planning question or task to break down."
      },
      "goal": {
        "type": "string"
      },
      "step": {
        "type": "integer"
      },
      "need_info": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "memory_context": {
        "type": "string"
      }
    },
    "anyOf": [
      { "required": ["question"] },
      { "required": ["goal", "step"] }
    ],
    "additionalProperties": true
  },
  "output_schema": {
    "type": "object"
  },
  "execution": {
    "timeout_ms": 5000,
    "sandbox": "process",
    "required_permissions": []
  }
}
