{
  "name": "mock-report",
  "version": "1.0.0",
  "description": "Mock reporting tool used by demo agent.",
  "input_schema": {
    "type": "object",
    "properties": {
      "content": {
        "type": "string",
        "description": "The content to summarize or report."
      },
      "summary": {
        "type": "string"
      },
      "goal": {
        "type": "string"
      },
      "step": {
        "type": "integer"
      },
      "memory_context": {
        "type": "string"
      }
    },
    "anyOf": [
      { "required": ["content"] },
      { "required": ["summary"] },
      { "required": ["goal", "step"] }
    ],
    "additionalProperties": true
  },
  "output_schema": {
    "type": "object"
  },
  "execution": {
    "timeout_ms": 5000,
    "sandbox": "process",
    "required_permissions": []
  }
}
