{
  "name": "mock-search",
  "version": "1.0.0",
  "description": "Mock search tool used by demo agent.",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "The search query to execute."
      },
      "q": {
        "type": "string",
        "description": "Short alias of query."
      },
      "goal": {
        "type": "string"
      },
      "memory_context": {
        "type": "string"
      },
      "filters": {
        "type": "object"
      }
    },
    "anyOf": [
      { "required": ["query"] },
      { "required": ["q"] },
      { "required": ["goal"] }
    ],
    "additionalProperties": true
  },
  "output_schema": {
    "type": "object"
  },
  "execution": {
    "timeout_ms": 5000,
    "sandbox": "process",
    "required_permissions": []
  }
}
