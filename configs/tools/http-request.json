{
  "name": "http-request",
  "version": "1.0.0",
  "description": "Mock HTTP request tool for integration testing.",
  "input_schema": {
    "type": "object",
    "properties": {
      "method": {
        "type": "string",
        "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
      },
      "url": {
        "type": "string"
      },
      "headers": {
        "type": "object"
      },
      "body": {
        "type": "object"
      }
    },
    "required": [
      "method",
      "url"
    ],
    "additionalProperties": true
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "mocked": {
        "type": "boolean"
      },
      "status_code": {
        "type": "integer"
      },
      "body": {
        "type": "object"
      }
    },
    "required": [
      "mocked",
      "status_code"
    ]
  },
  "execution": {
    "timeout_ms": 5000,
    "sandbox": "process",
    "required_permissions": []
  }
}
